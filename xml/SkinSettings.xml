<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">200</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0B0B0D">white.png</texture>
        </control>

        <control type="label">
            <left>90</left>
            <top>50</top>
            <width>1400</width>
            <height>70</height>
            <label>Accounts &amp; playback</label>
            <font>font27</font>
            <textcolor>FFFFFFFF</textcolor>
            <aligny>center</aligny>
        </control>

        <control type="grouplist" id="200">
            <left>90</left>
            <top>150</top>
            <width>1000</width>
            <height>860</height>
            <orientation>vertical</orientation>
            <itemgap>8</itemgap>

            <control type="label">
                <width>1000</width>
                <height>48</height>
                <label>Home shelves (metadata)</label>
                <font>font16</font>
                <textcolor>99FFFFFF</textcolor>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Use TMDb Helper for shelves</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <onclick>Skin.SetString(home_provider,tmdbhelper)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Open TMDb Helper settings</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <visible>System.HasAddon(plugin.video.themoviedb.helper)</visible>
                <onclick>Addon.OpenSettings(plugin.video.themoviedb.helper)</onclick>
            </control>

            <control type="label">
                <width>1000</width>
                <height>48</height>
                <label>Playback add-on</label>
                <font>font16</font>
                <textcolor>99FFFFFF</textcolor>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Play with Fen Light</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <onclick>Skin.SetString(play_provider,fenlight)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Open Fen Light settings (Trakt / debrid live here)</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <visible>System.HasAddon(plugin.video.fenlight)</visible>
                <onclick>Addon.OpenSettings(plugin.video.fenlight)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Play with Umbrella</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <onclick>Skin.SetString(play_provider,umbrella)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Open Umbrella settings (Trakt / debrid live here)</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <visible>System.HasAddon(plugin.video.umbrella)</visible>
                <onclick>Addon.OpenSettings(plugin.video.umbrella)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Open Trakt settings</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <visible>System.HasAddon(script.trakt)</visible>
                <onclick>Addon.OpenSettings(script.trakt)</onclick>
            </control>

            <control type="button">
                <width>1000</width>
                <height>72</height>
                <label>Back</label>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>28</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">white.png</texturenofocus>
                <onclick>ActivateWindow(Settings)</onclick>
            </control>
        </control>
    </controls>
</window>
