<?xml version="1.0" encoding="utf-8"?>
<!-- ATV Minimal: Apple TV style player controls.
     Shown together with DialogSeekBar.xml, which draws the gradient, title, scrubber and times.
     Transport buttons sit centred on the title line, options on the right; ids and actions are Estuary's. -->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>800</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<include condition="Skin.HasSetting(touchmode)">TouchBackOSDButton</include>
		<control type="group">
			<include>Animation_BottomSlide</include>
			<visible>![Window.IsVisible(SliderDialog) | Window.IsVisible(1110) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings) | Window.IsVisible(PVROSDChannels) | Window.IsVisible(pvrchannelguide)]</visible>
			<animation effect="fade" time="200">VisibleChange</animation>

			<!-- What is playing, opposite the help text -->
			<control type="label">
				<left>90</left><top>782</top><width>800</width><height>36</height>
				<aligny>center</aligny>
				<label>$VAR[ATV_PlayingRes]$VAR[ATV_PlayingHDR]$INFO[VideoPlayer.VideoCodec,  ·  ]$INFO[VideoPlayer.AudioCodec,  ·  ]$INFO[VideoPlayer.AudioChannels,  ·  ,ch]</label>
				<font>atv_small</font><textcolor>B3FFFFFF</textcolor>
			</control>

			<!-- What the focused button does -->
			<control type="label">
				<left>930</left><top>782</top><width>900</width><height>36</height>
				<align>right</align><aligny>center</aligny>
				<label>$VAR[OSDHelpTextVar]</label>
				<font>atv_small</font><textcolor>B3FFFFFF</textcolor>
			</control>

			<control type="group" id="200">
				<!-- Transport: centred on the title line -->
				<control type="grouplist" id="201">
					<left>560</left>
					<top>822</top>
					<width>800</width>
					<height>72</height>
					<align>center</align>
					<itemgap>18</itemgap>
					<scrolltime tween="sine">200</scrolltime>
					<orientation>horizontal</orientation>
					<onup>87</onup>
					<ondown>noop</ondown>
					<onleft>70048</onleft>
					<onright>804</onright>
					<control type="radiobutton" id="600">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/previous.png"/>
						</include>
						<onclick>PlayerControl(Previous)</onclick>
						<visible>Player.HasSceneMarkers | Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | [Player.SeekEnabled + VideoPlayer.Content(livetv)]</visible>
					</control>
					<control type="radiobutton" id="601">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/rewind.png"/>
						</include>
						<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
						<onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick>
						<visible>Player.SeekEnabled + !VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="group" id="698">
						<width>64</width>
						<height>64</height>
						<visible>Player.PauseEnabled</visible>
						<animation effect="zoom" start="100" end="112" center="32,32" time="200" tween="cubic" easing="out" condition="Control.HasFocus(602)">Conditional</animation>
						<control type="button" id="602">
							<left>0</left>
							<top>0</top>
							<width>64</width>
							<height>64</height>
							<label></label>
							<font></font>
							<texturefocus colordiffuse="FFFFFFFF">atv/mask_circle.png</texturefocus>
							<texturenofocus colordiffuse="2EFFFFFF">atv/mask_circle.png</texturenofocus>
							<onleft>601</onleft>
							<onright>603</onright>
							<onup>87</onup>
							<ondown>noop</ondown>
							<onclick>PlayerControl(Play)</onclick>
						</control>
						<control type="image">
							<left>12</left><top>12</top><width>40</width><height>40</height>
							<texture colordiffuse="FF0B0B0D">$VAR[ATV_OSDPlayIcon]</texture>
							<visible>Control.HasFocus(602)</visible>
						</control>
						<control type="image">
							<left>12</left><top>12</top><width>40</width><height>40</height>
							<texture colordiffuse="FFFFFFFF">$VAR[ATV_OSDPlayIcon]</texture>
							<visible>!Control.HasFocus(602)</visible>
						</control>
					</control>
					<control type="radiobutton" id="603">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/stop.png"/>
						</include>
						<onclick>PlayerControl(Stop)</onclick>
					</control>
					<control type="radiobutton" id="606">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/forward.png"/>
						</include>
						<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
						<onclick condition="!Player.Paused">PlayerControl(Forward)</onclick>
						<visible>Player.SeekEnabled + !VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="607">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/next.png"/>
						</include>
						<onclick>PlayerControl(Next)</onclick>
						<visible>Player.HasSceneMarkers | Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | PVR.IsTimeShift</visible>
					</control>
					<control type="radiobutton" id="608">
						<textureradioonfocus colordiffuse="FF0B0B0D">osd/fullscreen/buttons/record-white.png</textureradioonfocus>
						<textureradioonnofocus>osd/fullscreen/buttons/record-white.png</textureradioonnofocus>
						<textureradioofffocus>osd/fullscreen/buttons/record.png</textureradioofffocus>
						<textureradiooffnofocus>osd/fullscreen/buttons/record.png</textureradiooffnofocus>
						<texturefocus colordiffuse="FFFFFFFF">atv/mask_circle.png</texturefocus>
						<texturenofocus colordiffuse="2EFFFFFF">atv/mask_circle.png</texturenofocus>
						<width>64</width>
						<height>64</height>
						<radiowidth>40</radiowidth>
						<radioheight>40</radioheight>
						<radioposx>12</radioposx>
						<radioposy>12</radioposy>
						<font></font>
						<animation effect="zoom" start="100" end="112" center="32,32" time="200" tween="cubic" easing="out">Focus</animation>
						<animation effect="zoom" start="112" end="100" center="32,32" time="160" tween="cubic" easing="out">Unfocus</animation>
						<selected>!PVR.IsRecordingPlayingChannel</selected>
						<onclick>PVR.ToggleRecordPlayingChannel</onclick>
						<visible>PVR.CanRecordPlayingChannel</visible>
						<visible>VideoPlayer.Content(livetv)</visible>
					</control>
				</control>

				<!-- Options: right-aligned on the title line -->
				<control type="grouplist" id="202">
					<left>1230</left>
					<top>822</top>
					<width>600</width>
					<height>72</height>
					<align>right</align>
					<itemgap>18</itemgap>
					<scrolltime tween="sine">200</scrolltime>
					<orientation>horizontal</orientation>
					<onup>87</onup>
					<ondown condition="Control.HasFocus(70043)">11104</ondown>
					<ondown condition="Control.HasFocus(704)">12104</ondown>
					<ondown condition="Control.HasFocus(255)">13103</ondown>
					<onleft>608</onleft>
					<onright>600</onright>
					<control type="radiobutton" id="804">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/home.png"/>
						</include>
						<onclick>PlayerControl(ShowVideoMenu)</onclick>
						<visible>VideoPlayer.HasMenu</visible>
					</control>
					<control type="radiobutton" id="70040">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/channels.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(PVROSDChannels)</onclick>
						<visible>VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="70041">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/guide.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(pvrchannelguide)</onclick>
						<visible>VideoPlayer.Content(livetv) + VideoPlayer.HasEPG</visible>
					</control>
					<control type="radiobutton" id="70042">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/playlist.png"/>
						</include>
						<onclick>Dialog.Close(all, true)</onclick>
						<onclick>ActivateWindow(videoplaylist)</onclick>
						<visible>Integer.IsGreater(Playlist.Length(video),1)</visible>
					</control>
					<control type="radiobutton" id="70043">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/information.png"/>
						</include>
						<onclick>Info</onclick>
					</control>
					<control type="radiobutton" id="70044">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/bookmarks.png"/>
						</include>
						<onclick>ActivateWindow(videobookmarks)</onclick>
						<visible>!VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="70045">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/teletext.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(Teletext)</onclick>
						<visible>VideoPlayer.HasTeletext</visible>
					</control>
					<control type="radiobutton" id="70046">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/settings-subtitle.png"/>
						</include>
						<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
						<visible>!VideoPlayer.Content(LiveTV) | VideoPlayer.HasSubtitles</visible>
					</control>
					<control type="radiobutton" id="70047">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/stereoscopic.png"/>
						</include>
						<visible>VideoPlayer.IsStereoscopic</visible>
						<onclick>SetProperty(settingslist_content,3d,home)</onclick>
						<onclick>SetProperty(settingslist_header,$LOCALIZE[36501],home)</onclick>
						<onclick>ActivateWindow(1101)</onclick>
					</control>
					<control type="radiobutton" id="70048">
						<include content="ATV_OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/settings.png"/>
						</include>
						<onclick>SetProperty(settingslist_content,osd,home)</onclick>
						<onclick>SetProperty(settingslist_header,$LOCALIZE[5],home)</onclick>
						<onclick>ActivateWindow(1101)</onclick>
					</control>
				</control>
			</control>

			<!-- Seek: Up from the buttons focuses hidden button 87; Left/Right then step through the video.
			     The sliders only draw the playhead dot on DialogSeekBar's scrubber (bigger while seeking). -->
			<control type="group" id="6000">
				<visible>Player.SeekEnabled</visible>
				<control type="button" id="87">
					<include>HiddenObject</include>
					<onup>200</onup>
					<ondown>200</ondown>
					<onleft>StepBack</onleft>
					<onright condition="!Player.Paused">StepForward</onright>
					<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				</control>
				<control type="slider">
					<left>80</left><top>940</top><width>1760</width><height>20</height>
					<texturesliderbar colordiffuse="00FFFFFF">atv/nib.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">atv/nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">atv/nib.png</textureslidernibfocus>
					<info>Player.Progress</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<action>seek</action>
					<visible>!Control.HasFocus(87) + !VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="slider">
					<left>75</left><top>935</top><width>1770</width><height>30</height>
					<texturesliderbar colordiffuse="00FFFFFF">atv/nib.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">atv/nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">atv/nib.png</textureslidernibfocus>
					<info>Player.Progress</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<action>seek</action>
					<visible>Control.HasFocus(87) + !VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="slider">
					<left>80</left><top>940</top><width>1760</width><height>20</height>
					<texturesliderbar colordiffuse="00FFFFFF">atv/nib.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">atv/nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">atv/nib.png</textureslidernibfocus>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<action>pvr.seek</action>
					<visible>!Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="slider">
					<left>75</left><top>935</top><width>1770</width><height>30</height>
					<texturesliderbar colordiffuse="00FFFFFF">atv/nib.png</texturesliderbar>
					<textureslidernib colordiffuse="FFFFFFFF">atv/nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="FFFFFFFF">atv/nib.png</textureslidernibfocus>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<action>pvr.seek</action>
					<visible>Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
