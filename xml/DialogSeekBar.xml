		<!-- ===================== ATV Minimal: Apple TV style player bar ===================== -->
		<control type="group">
			<visible>Window.IsActive(fullscreenvideo) + !VideoPlayer.Content(LiveTV) + !Player.HasGame</visible>
			<visible>!Window.IsVisible(playerprocessinfo)</visible>

			<!-- Soft gradient so white text reads over any picture -->
