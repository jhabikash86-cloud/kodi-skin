<?xml version="1.0" encoding="UTF-8"?>
<window id="1120">
    <defaultcontrol always="true">8100</defaultcontrol>

    <!-- Default to movie results the first time this window is ever opened -->
    <onload condition="String.IsEmpty(Skin.String(SearchType))">Skin.SetString(SearchType,movie)</onload>

    <controls>

        <!-- Background: same dark base as Home -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0B0D">white.png</texture>
        </control>

        <!-- Backdrop of whatever poster is highlighted, kept very subtle -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio align="center" aligny="center">scale</aspectratio>
            <fadetime>400</fadetime>
            <colordiffuse>40FFFFFF</colordiffuse>
            <texture background="true" fallback="fallback.png">$INFO[Container(8110).ListItem.Art(fanart)]</texture>
            <visible>Control.HasFocus(8110)</visible>
            <animation effect="fade" time="400">VisibleChange</animation>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="CC0B0B0D">white.png</texture>
        </control>

        <!-- ===== HEADER ===== -->

        <control type="label">
            <left>90</left><top>44</top><width>600</width><height>50</height>
            <label>Search</label>
            <font>font45</font>
            <textcolor>FFFFFFFF</textcolor>
        </control>

        <control type="label">
            <left>1480</left><top>48</top><width>340</width><height>50</height>
            <label>$INFO[System.Time]</label>
            <font>font16</font>
            <textcolor>B3FFFFFF</textcolor>
            <align>right</align><aligny>center</aligny>
        </control>

        <!-- ===== SEARCH FIELD ===== -->

        <control type="button" id="8100">
            <left>90</left><top>130</top><width>1160</width><height>76</height>
            <label>$INFO[Skin.String(SearchQuery)]</label>
            <font>font16</font>
            <textcolor>FFFFFFFF</textcolor><focusedcolor>FF0B0B0D</focusedcolor>
            <textoffsetx>28</textoffsetx>
            <aligny>center</aligny>
            <texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus>
            <texturenofocus colordiffuse="1AFFFFFF">white.png</texturenofocus>
            <pulseonselect>false</pulseonselect>
            <onclick>Skin.SetString(SearchQuery)</onclick>
            <onclick>SetFocus(8110)</onclick>
            <onclick>Container.Refresh</onclick>
            <onright>8101</onright>
            <ondown>8110</ondown>
        </control>

        <!-- Placeholder text, shown only while the query is empty -->
        <control type="label">
            <left>118</left><top>130</top><width>900</width><height>76</height>
            <label>Search movies and TV shows</label>
            <font>font16</font>
            <textcolor>80FFFFFF</textcolor>
            <aligny>center</aligny>
            <visible>String.IsEmpty(Skin.String(SearchQuery)) + !Control.HasFocus(8100)</visible>
        </control>

        <!-- ===== MOVIES / TV TOGGLE ===== -->

        <control type="button" id="8101">
            <left>1270</left><top>130</top><width>180</width><height>76</height>
            <label>Movies</label>
            <font>font16</font>
            <textcolor>66FFFFFF</textcolor><focusedcolor>FF0B0B0D</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus>
            <texturenofocus colordiffuse="1AFFFFFF">white.png</texturenofocus>
            <pulseonselect>false</pulseonselect>
            <onclick>Skin.SetString(SearchType,movie)</onclick>
            <onclick>SetFocus(8110)</onclick>
            <onclick>Container.Refresh</onclick>
            <onleft>8100</onleft>
            <onright>8102</onright>
            <ondown>8110</ondown>
        </control>
        <control type="image">
            <left>1270</left><top>198</top><width>180</width><height>3</height>
            <texture colordiffuse="FFFFFFFF">white.png</texture>
            <visible>String.IsEqual(Skin.String(SearchType),movie)</visible>
        </control>

        <control type="button" id="8102">
            <left>1470</left><top>130</top><width>180</width><height>76</height>
            <label>TV Shows</label>
            <font>font16</font>
            <textcolor>66FFFFFF</textcolor><focusedcolor>FF0B0B0D</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus>
            <texturenofocus colordiffuse="1AFFFFFF">white.png</texturenofocus>
            <pulseonselect>false</pulseonselect>
            <onclick>Skin.SetString(SearchType,tv)</onclick>
            <onclick>SetFocus(8110)</onclick>
            <onclick>Container.Refresh</onclick>
            <onleft>8101</onleft>
            <onright>8103</onright>
            <ondown>8110</ondown>
        </control>
        <control type="image">
            <left>1470</left><top>198</top><width>180</width><height>3</height>
            <texture colordiffuse="FFFFFFFF">white.png</texture>
            <visible>String.IsEqual(Skin.String(SearchType),tv)</visible>
        </control>

        <!-- Clear -->
        <control type="button" id="8103">
            <left>1670</left><top>130</top><width>160</width><height>76</height>
            <label>Clear</label>
            <font>font16</font>
            <textcolor>66FFFFFF</textcolor><focusedcolor>FF0B0B0D</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus>
            <texturenofocus colordiffuse="1AFFFFFF">white.png</texturenofocus>
            <pulseonselect>false</pulseonselect>
            <onclick>Skin.Reset(SearchQuery)</onclick>
            <onclick>SetFocus(8100)</onclick>
            <onleft>8102</onleft>
            <ondown>8120</ondown>
            <enable>!String.IsEmpty(Skin.String(SearchQuery))</enable>
        </control>

        <!-- ===== RESULTS ===== -->

        <control type="label">
            <left>90</left><top>246</top><width>1200</width><height>34</height>
            <font>font16</font><textcolor>FFFFFFFF</textcolor>
            <label>Results for "$INFO[Skin.String(SearchQuery)]"</label>
            <visible>!String.IsEmpty(Skin.String(SearchQuery))</visible>
        </control>
        <control type="label">
            <left>90</left><top>246</top><width>1200</width><height>34</height>
            <font>font16</font><textcolor>FFFFFFFF</textcolor>
            <label>Trending This Week</label>
            <visible>String.IsEmpty(Skin.String(SearchQuery))</visible>
        </control>

        <control type="label">
            <left>90</left><top>420</top><width>1200</width><height>40</height>
            <font>font16</font><textcolor>80FFFFFF</textcolor>
            <label>Searching…</label>
            <visible>Container(8110).IsUpdating</visible>
        </control>
        <control type="label">
            <left>90</left><top>420</top><width>1400</width><height>40</height>
            <font>font16</font><textcolor>80FFFFFF</textcolor>
            <label>No matches. Try a shorter title, or switch between Movies and TV Shows.</label>
            <visible>!String.IsEmpty(Skin.String(SearchQuery)) + !Container(8110).IsUpdating + Integer.IsLess(Container(8110).NumItems,1)</visible>
        </control>

        <!-- Search result grid -->
        <control type="panel" id="8110">
            <left>90</left><top>290</top><width>1760</width><height>760</height>
            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <scrolltime tween="quadratic" easing="out">280</scrolltime>
            <onup>8100</onup>
            <visible>!String.IsEmpty(Skin.String(SearchQuery))</visible>
            <itemlayout width="244" height="380">
                <control type="image">
                    <left>0</left><top>0</top><width>220</width><height>330</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" fallback="fallback.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>0</left><top>336</top><width>220</width><height>30</height>
                    <align>center</align>
                    <font>font12</font>
                    <textcolor>B3FFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="244" height="380">
                <control type="image">
                    <left>-5</left><top>-5</top><width>230</width><height>340</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" fallback="fallback.png">$INFO[ListItem.Art(poster)]</texture>
                    <bordertexture colordiffuse="FFFFFFFF">white.png</bordertexture>
                    <bordersize>2</bordersize>
                    <animation effect="zoom" start="94" end="100" center="110,165" time="180" tween="quadratic" easing="out">Focus</animation>
                </control>
                <control type="label">
                    <left>0</left><top>336</top><width>220</width><height>30</height>
                    <align>center</align>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
            <content sortby="none" limit="40" target="videos">plugin://plugin.video.themoviedb.helper/?info=search&amp;type=$INFO[Skin.String(SearchType)]&amp;query=$INFO[Skin.String(SearchQuery)]</content>
        </control>

        <!-- Empty state: suggestions before anything is typed -->
        <control type="panel" id="8120">
            <left>90</left><top>290</top><width>1760</width><height>760</height>
            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <scrolltime tween="quadratic" easing="out">280</scrolltime>
            <onup>8100</onup>
            <visible>String.IsEmpty(Skin.String(SearchQuery))</visible>
            <itemlayout width="244" height="380">
                <control type="image">
                    <left>0</left><top>0</top><width>220</width><height>330</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" fallback="fallback.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>0</left><top>336</top><width>220</width><height>30</height>
                    <align>center</align>
                    <font>font12</font>
                    <textcolor>B3FFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="244" height="380">
                <control type="image">
                    <left>-5</left><top>-5</top><width>230</width><height>340</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" fallback="fallback.png">$INFO[ListItem.Art(poster)]</texture>
                    <bordertexture colordiffuse="FFFFFFFF">white.png</bordertexture>
                    <bordersize>2</bordersize>
                    <animation effect="zoom" start="94" end="100" center="110,165" time="180" tween="quadratic" easing="out">Focus</animation>
                </control>
                <control type="label">
                    <left>0</left><top>336</top><width>220</width><height>30</height>
                    <align>center</align>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
            <content sortby="none" limit="20" target="videos">plugin://plugin.video.themoviedb.helper/?info=trending_week&amp;tmdb_type=movie</content>
        </control>

    </controls>
</window>