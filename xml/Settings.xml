<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings hub. Estuary shows a grid of grey tiles; this is a single tvOS-style
     list - icon, label, chevron - so it matches the rest of the skin and reads at
     a distance. The items are the same ones Estuary offers, reordered so the ones
     people actually open are at the top. -->
<window>
	<defaultcontrol>9100</defaultcontrol>
	<backgroundcolor>FF0B0B0D</backgroundcolor>
	<controls>

		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF0B0B0D">white.png</texture>
		</control>

		<control type="label">
			<left>90</left><top>142</top><width>900</width><height>70</height>
			<label>$LOCALIZE[5]</label>
			<font>atv_pagetitle</font><textcolor>FFFFFFFF</textcolor>
		</control>

		<control type="list" id="9100">
			<left>82</left><top>240</top><width>1240</width><height>792</height>
			<onup>9005</onup>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<scrolltime tween="sine" easing="inout">280</scrolltime>
			<include>ATV_SettingsRow</include>
			<content>
				<!-- How Play chooses a release. Off (the default) opens Umbrella's Source Select,
				     and you pick from the full list of sizes and qualities; on, the same press
				     goes to Umbrella's Auto Play, which starts the top source and falls through
				     to the next if it will not play. Two items rather than one so the row states
				     which way it is set instead of only what it would switch to. -->
				<item>
					<label>Play  ·  ask me which source</label>
					<visible>!Skin.HasSetting(atv.autopick)</visible>
					<onclick>Skin.ToggleSetting(atv.autopick)</onclick>
					<icon>icons/settings/player.png</icon>
				</item>
				<item>
					<label>Play  ·  pick the best automatically</label>
					<visible>Skin.HasSetting(atv.autopick)</visible>
					<onclick>Skin.ToggleSetting(atv.autopick)</onclick>
					<icon>icons/settings/player.png</icon>
				</item>
				<!-- The hero's trailer previews. They come through the YouTube add-on, which
				     takes 2-40s to find one and holds Kodi's busy dialog while it does. -->
				<item>
					<label>Banner trailers  ·  on</label>
					<visible>!Skin.HasSetting(atv.notrailers)</visible>
					<onclick>Skin.ToggleSetting(atv.notrailers)</onclick>
					<icon>icons/settings/player.png</icon>
				</item>
				<item>
					<label>Banner trailers  ·  off</label>
					<visible>Skin.HasSetting(atv.notrailers)</visible>
					<onclick>Skin.ToggleSetting(atv.notrailers)</onclick>
					<icon>icons/settings/player.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[14206]</label>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
					<icon>icons/settings/interface.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[14200]</label>
					<onclick>ActivateWindow(PlayerSettings)</onclick>
					<icon>icons/settings/player.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[14211]</label>
					<onclick>ActivateWindow(MediaSettings)</onclick>
					<icon>icons/settings/media.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[24001]</label>
					<onclick>ActivateWindow(addonbrowser)</onclick>
					<icon>icons/settings/addons.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[14036]</label>
					<onclick>ActivateWindow(ServiceSettings)</onclick>
					<icon>icons/settings/network.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[13000]</label>
					<onclick>ActivateWindow(SystemSettings)</onclick>
					<icon>icons/settings/system.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[14204]</label>
					<onclick>ActivateWindow(PVRSettings)</onclick>
					<icon>icons/settings/livetv.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[15016]</label>
					<visible>System.GetBool(gamesgeneral.enable)</visible>
					<onclick>ActivateWindow(GameSettings)</onclick>
					<icon>icons/settings/games.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[13200]</label>
					<onclick>ActivateWindow(Profiles)</onclick>
					<icon>icons/settings/profiles.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[10003]</label>
					<onclick>ActivateWindow(filemanager)</onclick>
					<icon>icons/settings/filemanager.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[138]</label>
					<onclick>ActivateWindow(systeminfo)</onclick>
					<icon>icons/settings/sysinfo.png</icon>
				</item>
				<item>
					<label>$LOCALIZE[31067]</label>
					<onclick>ActivateWindow(eventlog)</onclick>
					<icon>icons/settings/eventlog.png</icon>
				</item>
				<item>
					<label>LibreELEC</label>
					<onclick>RunAddon(service.libreelec.settings)</onclick>
					<icon>icons/settings/libreelec.png</icon>
					<visible>System.AddonIsEnabled(service.libreelec.settings)</visible>
				</item>
			</content>
		</control>

		<!-- Rows scrolling under the title dissolve into the top edge -->
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>190</height>
			<texture>atv/grad_top.png</texture>
			<visible>Control.HasFocus(9100) + !Integer.IsEqual(Container(9100).CurrentItem,1)</visible>
			<animation effect="fade" time="300">VisibleChange</animation>
		</control>

		<include content="ATV_TabBar">
			<param name="ondown" value="9100" />
		</include>

	</controls>
</window>
