            </control>
            <control type="list" id="3">
                <left>40</left>
                <top>90</top>
                <width>720</width>
                <height>500</height>
                <itemlayout height="64" width="720">
                    <control type="label">
                        <left>20</left>
                        <width>680</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font14</font>
                        <textcolor>99FFFFFF</textcolor>
                        <info>ListItem.Label</info>
                    </control>
                </itemlayout>
                <focusedlayout height="64" width="720">
                    <control type="image">
                        <width>720</width>
                        <height>64</height>
                        <texture colordiffuse="FF3A3A3C">white.png</texture>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <width>680</width>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>font14</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <info>ListItem.Label</info>
                    </control>
                </focusedlayout>
            </control>
            <control type="button" id="5">
                <left>80</left>
                <top>620</top>
                <width>280</width>
                <height>56</height>
                <label>OK</label>
                <font>font14</font>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="FF3A3A3C">white.png</texturefocus>
                <texturenofocus colordiffuse="FF2C2C2E">white.png</texturenofocus>
            </control>
            <control type="button" id="7">
                <left>440</left>
                <top>620</top>
                <width>280</width>
                <height>56</height>
