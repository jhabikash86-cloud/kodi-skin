<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">white.png</texture>
        </control>
        <control type="group">
            <left>560</left>
            <top>180</top>
            <width>800</width>
            <height>720</height>
