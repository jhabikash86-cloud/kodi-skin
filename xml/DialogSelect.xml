                <width>800</width>
                <height>720</height>
                <texture colordiffuse="FF1C1C1E">white.png</texture>
            </control>
            <control type="label" id="1">
                <left>40</left>
                <top>24</top>
                <width>720</width>
                <height>50</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
