<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE for tools/gen_home.py, which fills in the scroll steps and the row list.
     Edit this file for the hero and the chrome; edit the generator for the rows. -->
<window>
    <defaultcontrol>8001</defaultcontrol>
    <menucontrol>9000</menucontrol>
    <!-- Not once Kodi is quitting: a script started then held Kodi's quit (extras/waiting.py).
         The trailer watcher starts from the hero's Play button, which has focus as Home opens;
         starting it here as well ran two at once, and on the Xbox each Python start costs. -->
    <!-- Four seconds after Home opens, not with it: at a cold start the rows on screen need
         the Xbox's CPU, and every Python start then slowed the others (Home's first rows
         took 6-14s with fifteen starting in the same second). -->
    <onload condition="String.IsEmpty(Window(home).Property(ATVQuitting)) + String.IsEmpty(Window(home).Property(ATVPrefetchWatcher))">CancelAlarm(atvprefetch,true)</onload>
    <onload condition="String.IsEmpty(Window(home).Property(ATVQuitting)) + String.IsEmpty(Window(home).Property(ATVPrefetchWatcher))">AlarmClock(atvprefetch,RunScript(special://skin/extras/prefetch.py),00:04,silent)</onload>
    <!-- Leaving Home ends a trailer preview - but only that. Unconditionally, this stopped
         everything: starting an episode from Continue Watching, or a film from the hero,
         switches to full-screen video, which unloads Home, and the episode was stopped
         0.7s after its first frame. -->
    <onunload condition="!String.IsEmpty(Window(home).Property(ATVPreview))">Action(Stop)</onunload>
    <controls>

        <!-- Hidden data list that feeds the hero ("top shelf"). Rotates every 10s. -->
        <control type="list" id="40">
            <!-- Never keep focus: if Kodi drops it here (the focused control vanished), hand it on -->
            <onfocus>SetFocus(8001)</onfocus>
            <left>0</left><top>1078</top><width>1740</width><height>2</height>
            <orientation>horizontal</orientation>
            <!-- Only rotates while you are idle, so the title never changes under your hands -->
            <!-- Holds still while a trailer is previewing, or the hero would rotate out from
			     under it a few seconds in and cut the trailer off. -->
			<autoscroll time="9000">System.IdleTime(5) + String.IsEmpty(Window(home).Property(ATVPreview))</autoscroll>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content limit="8">plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;primary_release_date.gte=$INFO[Skin.String(ATVDate.d45)]&amp;primary_release_date.lte=$INFO[Skin.String(ATVDate.today)]&amp;sort_by=popularity.desc&amp;vote_count.gte=20&amp;hide_unaired=true&amp;nextpage=false</content>
        </control>

        <!-- Seed for "Because You Watched": the most recent film in your Trakt history.
             The row below reads its title and id, so the row follows what you watch. -->
        <control type="list" id="6070">
            <onfocus>SetFocus(8001)</onfocus>
            <!-- Only once you head into the rows: it feeds a row five down, and at a cold start
                 it was one more Trakt-bound TMDb Helper run competing with the rows on screen -->
            <visible>Control.HasFocus(51) | ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</visible>
            <left>0</left><top>1078</top><width>10</width><height>2</height>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content limit="1">plugin://plugin.video.themoviedb.helper/?info=trakt_history&amp;tmdb_type=movie&amp;nextpage=false</content>
        </control>

        <!-- ===================== FIXED BACKGROUND ===================== -->

        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0B0D">white.png</texture>
        </control>

        <!-- Hero backdrop: full bleed, slow Ken Burns drift. Moving into the rows carries it up
             and away as it fades, the way Apple TV's billboard scrolls off with the page,
             rather than dimming in place behind the rows. -->
        <control type="group">
            <animation effect="fade" start="100" end="0" time="380" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>
            <animation effect="slide" end="0,-320" time="380" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <aspectratio align="center" aligny="top">scale</aspectratio>
                <fadetime>600</fadetime>
                <texture background="true">$VAR[ATV_HeroFanart]</texture>
                <animation effect="zoom" start="100" end="107" center="960,400" time="22000" tween="linear" pulse="true" condition="true">Conditional</animation>
            </control>
            <!-- Trailer preview. extras/trailer.py starts it after a couple of seconds of
                 stillness on the hero and stops it the moment you move; the still
                 backdrop underneath stays put so there is no gap while it loads. -->
            <!-- Black behind the picture: a trailer wider than the screen is letterboxed, and
                 the still backdrop showed in strips above and below it -->
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <texture colordiffuse="FF000000">white.png</texture>
                <visible>$EXP[ATV_TrailerFull]</visible>
                <animation effect="fade" start="0" end="100" time="500">Visible</animation>
                <animation effect="fade" start="100" end="0" time="200">Hidden</animation>
            </control>
            <control type="videowindow">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <!-- ATVPreviewShape is set once the picture is known to be widescreen, so a
                     square social-media cut is never seen before it is stopped -->
                <visible>!String.IsEmpty(Window(home).Property(ATVPreview)) + !String.IsEmpty(Window(home).Property(ATVPreviewShape)) + Player.HasVideo</visible>
                <animation effect="fade" start="0" end="100" time="500">Visible</animation>
                <animation effect="fade" start="100" end="0" time="200">Hidden</animation>
            </control>
            <!-- The shades that make the text readable; gone while a trailer plays -->
            <control type="group">
    <animation effect="fade" start="100" end="0" time="900" delay="2500" tween="sine" easing="inout" condition="$EXP[ATV_TrailerFull]">Conditional</animation>
                <control type="image">
                    <left>0</left><top>0</top><width>1300</width><height>1080</height>
                    <texture>atv/grad_left.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>420</top><width>1920</width><height>660</height>
                    <texture colordiffuse="FF0B0B0D">atv/grad_bottom.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>0</top><width>1920</width><height>240</height>
                    <texture colordiffuse="B3FFFFFF">atv/grad_top.png</texture>
                </control>
            </control>
        </control>

        <!-- ===== HERO =====
             Scrolls off with the page: the same 710px, time and curve as the rows' first step
             (tools/gen_home.py), so the logo, text and buttons move as one piece with the rows
             instead of dimming in place while the rows slide over them. The backdrop behind
             moves less, for depth. -->
        <control type="group">
            <left>90</left><top>0</top>
            <animation effect="fade" start="100" end="0" time="380" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>
            <animation effect="slide" end="0,-710" time="380" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>
            <animation effect="fade" start="100" end="0" time="900" delay="2500" tween="sine" easing="inout" condition="$EXP[ATV_TrailerFull]">Conditional</animation>

            <!-- Clear logo, or the title in bold if there's no logo -->
            <control type="image">
                <left>0</left><top>350</top><width>640</width><height>210</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <fadetime>400</fadetime>
                <texture background="true">$VAR[ATV_HeroLogo]</texture>
                <visible>$EXP[ATV_HeroHasLogo]</visible>
            </control>
            <control type="textbox">
                <left>0</left><top>390</top><width>1100</width><height>170</height>
                <label>$VAR[ATV_HeroTitle]</label>
                <font>atv_hero</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <visible>!$EXP[ATV_HeroHasLogo]</visible>
            </control>

            <!-- Movie · 2025 · Thriller / Drama · ★ 7.8 -->
            <control type="label">
                <left>0</left><top>580</top><width>1100</width><height>34</height>
                <label>$VAR[ATV_HeroMeta]</label>
                <font>atv_meta</font>
                <textcolor>B3FFFFFF</textcolor>
            </control>
            <control type="textbox">
                <left>0</left><top>622</top><width>800</width><height>70</height>
                <label>$VAR[ATV_HeroPlot]</label>
                <font>atv_body</font>
                <textcolor>D9FFFFFF</textcolor>
            </control>

            <!-- Play / More Info capsules. Left/right past the ends flips through the hero items. -->
            <control type="group">
                <left>0</left><top>722</top><width>206</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8001)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8001" />
                    <param name="width" value="206" />
                    <param name="label" value="Play" />
                    <param name="icon" value="atv/icon_play.png" />
                    <onfocus condition="String.IsEmpty(Window(home).Property(ATVQuitting)) + String.IsEmpty(Window(home).Property(ATVPreviewWatcher))">CancelAlarm(atvtrailer,true)</onfocus>
                    <onfocus condition="String.IsEmpty(Window(home).Property(ATVQuitting)) + String.IsEmpty(Window(home).Property(ATVPreviewWatcher))">AlarmClock(atvtrailer,RunScript(special://skin/extras/trailer.py),00:03,silent)</onfocus>
                    <onclick>RunScript(special://skin/extras/play.py,movie,$INFO[Container(40).ListItem.UniqueID(tmdb)],$INFO[Container(40).ListItem.Property(original_language)])</onclick>
                    <onback>SetFocus(9001)</onback>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>Control.Move(40,-1)</onleft>
                    <onright>8003</onright>
                </include>
            </control>
            <control type="group">
                <left>226</left><top>722</top><width>250</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8003)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8003" />
                    <param name="width" value="250" />
                    <param name="label" value="My List" />
                    <param name="icon" value="atv/icon_plus.png" />
                    <!-- Adds / removes the title on your Trakt watchlist -->
                    <onclick>RunScript(plugin.video.themoviedb.helper,sync_trakt,tmdb_type=movie,tmdb_id=$INFO[Container(40).ListItem.UniqueID(tmdb)],sync_type=watchlist)</onclick>
                    <onback>SetFocus(9001)</onback>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>8001</onleft>
                    <onright>8002</onright>
                </include>
            </control>
            <control type="group">
                <left>496</left><top>722</top><width>290</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8002)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8002" />
                    <param name="width" value="290" />
                    <param name="label" value="More Info" />
                    <param name="icon" value="atv/icon_info.png" />
                                        <!-- Opens the Apple TV style title page for the hero item -->
                    <onclick>RunScript(special://skin/extras/details.py,open,40)</onclick>
                    <onback>SetFocus(9001)</onback>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>8003</onleft>
                    <onright>Control.Move(40,1)</onright>
                </include>
            </control>

            <!-- Page dots for the hero carousel -->
            <control type="grouplist">
                <left>0</left><top>818</top><width>400</width><height>12</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor1]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,1)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor2]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,2)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor3]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,3)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor4]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,4)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor5]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,5)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor6]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,6)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor7]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,7)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor8]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,8)</visible></control>
            </control>
        </control>

        <!-- ===================== SCROLLING PAGE ===================== -->
        <control type="group" id="7000">
            <left>0</left><top>0</top>
            <animation effect="fade" start="100" end="0" time="900" delay="2500" tween="sine" easing="inout" condition="$EXP[ATV_TrailerFull]">Conditional</animation>

            <!-- Page scroll, built from steps that add up rather than one absolute position
                 per row. Moving one row toggles exactly ONE of these, so nothing overlaps:
                 with absolute positions Kodi runs the old row's slide backwards while the new
                 one plays forward and adds them, which overshot badly with ease-out and
                 hesitated with a slow-start curve. The last rows share an offset, so the page
                 stops with the final row at the bottom.
                 Totals: 50 -710, 51 -1115, 52 -1590, 53 -2065, 54 -2540, 55 -3015, 56 -3490, 57 -3965, 58 -4440, 59 -4915, 60 -5390, 61 -5490 -->
            <animation effect="slide" end="0,-710" time="380" tween="sine" easing="inout" condition="Control.HasFocus(50) | Control.HasFocus(51) | ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-405" time="380" tween="sine" easing="inout" condition="!$EXP[ATV_UpNextEmpty] + [Control.HasFocus(51) | ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)]">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-475" time="380" tween="sine" easing="inout" condition="Control.HasFocus(60) | Control.HasFocus(61)">Conditional</animation>
            <animation effect="slide" end="0,-100" time="380" tween="sine" easing="inout" condition="Control.HasFocus(61)">Conditional</animation>

            <!-- ===== ROWS ===== -->
            <!-- Continue Watching: the films and episodes you actually paused (Trakt on deck),
                 the more recently used list first. trakt_nextepisodes looks tidier (one row per
                 show) but only lists shows you have FINISHED an episode of, which dropped most
                 of the row. -->
            <include content="ATV_UpNextRow">
                <param name="id" value="50" />
                <param name="top" value="860" />
                <param name="label" value="Continue Watching" />
                <param name="onup" value="8001" />
                <param name="ondown" value="51" />
                <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_ondeck&amp;tmdb_type=tv&amp;exclude_key=ResumeTime&amp;exclude_value=0&amp;exclude_operator=eq&amp;filter_key=lastplayed.original&amp;filter_value=$DAYS[-90]&amp;filter_operator=gt&amp;reload=$INFO[Window(home).Property(ATVContinueReload)]&amp;nextpage=false" />
            </include>

            <control type="group">
                <animation effect="slide" end="0,-405" time="400" tween="quadratic" easing="inout" condition="$EXP[ATV_UpNextEmpty]">Conditional</animation>
            <include content="ATV_UpNextRow">
                <param name="id" value="51" />
                <param name="top" value="1265" />
                <param name="label" value="Continue Watching Films" />
                <param name="onup" value="50" />
                <param name="ondown" value="52" />
                <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_ondeck&amp;tmdb_type=movie&amp;exclude_key=ResumeTime&amp;exclude_value=0&amp;exclude_operator=eq&amp;filter_key=lastplayed.original&amp;filter_value=$DAYS[-90]&amp;filter_operator=gt&amp;reload=$INFO[Window(home).Property(ATVContinueReload)]&amp;nextpage=false" />
                <param name="empty" value="Integer.IsEqual(Container(51).NumItems,0)" />
            </include>
                <include content="ATV_RankRow">
                    <param name="id" value="52" />
                    <param name="idbase" value="61" />
                    <param name="data" value="6052" />
                    <param name="top" value="1740" />
                    <param name="label" value="Top 10 Movies Right Now" />
                    <param name="onup" value="51" />
                    <param name="ondown" value="53" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_trending&amp;tmdb_type=movie&amp;hide_unaired=true&amp;nextpage=false" />
                </include>
                <control type="group">
                    <visible>Control.HasFocus(51) | ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</visible>
                    <include content="ATV_RankRow">
                        <param name="id" value="53" />
                        <param name="idbase" value="62" />
                        <param name="data" value="6053" />
                        <param name="top" value="2215" />
                        <param name="label" value="Top 10 Shows Right Now" />
                        <param name="onup" value="52" />
                        <param name="ondown" value="54" />
                        <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_trending&amp;tmdb_type=tv&amp;hide_unaired=true&amp;nextpage=false" />
                    </include>
                </control>
                <control type="group">
                    <visible>ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</visible>
                    <include content="ATV_PosterRow">
                        <param name="id" value="54" />
                        <param name="top" value="2690" />
                        <param name="label" value="Recommended for You" />
                        <param name="onup" value="53" />
                        <param name="ondown" value="55" />
                        <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_recommendations&amp;tmdb_type=movie&amp;hide_unaired=true&amp;nextpage=false" />
                    </include>
                </control>
                <control type="group">
                    <visible>ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</visible>
                    <include content="ATV_PosterRow">
                        <param name="id" value="55" />
                        <param name="top" value="3165" />
                        <param name="label" value="Because You Watched $INFO[Container(6070).ListItem.Title]" />
                        <param name="onup" value="54" />
                        <param name="ondown" value="56" />
                        <param name="content" value="$VAR[ATV_BecauseYouWatchedPath]" />
                    </include>
                </control>
                <control type="group">
                    <visible>Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</visible>
                    <include content="ATV_RankRow">
                        <param name="id" value="56" />
                        <param name="idbase" value="63" />
                        <param name="data" value="6056" />
                        <param name="top" value="3640" />
                        <param name="label" value="Top 10 on Netflix" />
                        <param name="onup" value="55" />
                        <param name="ondown" value="57" />
                        <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_watch_providers=8&amp;watch_region=IN&amp;sort_by=popularity.desc&amp;primary_release_date.gte=$INFO[Skin.String(ATVDate.d540)]&amp;vote_count.gte=20&amp;hide_unaired=true&amp;nextpage=false" />
