        <!-- ============ BILLBOARD ============ -->

        <control type="group">
            <left>90</left><top>430</top>
            <animation effect="fade" start="100" end="30" time="250" condition="Control.HasFocus(50) | Control.HasFocus(51) | Control.HasFocus(52) | Control.HasFocus(53) | Control.HasFocus(54)">Conditional</animation>

            <control type="image">
                <left>0</left><top>0</top><width>620</width><height>170</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <fadetime>300</fadetime>
                <texture>$INFO[Container(40).ListItem.Art(clearlogo)]</texture>
                <visible>!String.IsEmpty(Container(40).ListItem.Art(clearlogo))</visible>
            </control>
            <control type="label">
                <left>0</left><top>100</top><width>1100</width><height>70</height>
                <label>$INFO[Container(40).ListItem.Title]</label>
                <font>font45</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <scroll>true</scroll>
                <visible>String.IsEmpty(Container(40).ListItem.Art(clearlogo))</visible>
            </control>

            <control type="label">
                <left>0</left><top>186</top><width>1100</width><height>34</height>
                <label>$INFO[Container(40).ListItem.Year]$INFO[Container(40).ListItem.Genre,  ·  ]$INFO[Container(40).ListItem.Rating,  ·  ]</label>
                <font>font13</font>
                <textcolor>B3FFFFFF</textcolor>
            </control>

            <control type="textbox">
                <left>0</left><top>228</top><width>760</width><height>110</height>
                <label>$INFO[Container(40).ListItem.Plot]</label>
                <font>font13</font>
                <textcolor>D0FFFFFF</textcolor>
                <autoscroll time="3000" delay="6000" repeat="8000">true</autoscroll>
            </control>

            <control type="button" id="8001">
                <left>0</left><top>352</top><width>230</width><height>62</height>
                <label>More Info</label>
                <font>font16</font>
                <textcolor>FF0B0B0D</textcolor><focusedcolor>FF0B0B0D</focusedcolor>
                <align>center</align><aligny>center</aligny>
                <texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="B0FFFFFF">white.png</texturenofocus>
                <pulseonselect>false</pulseonselect>
                <onclick>SendClick(40)</onclick>
                <onup>9001</onup>
                <ondown condition="Integer.IsGreater(Container(50).NumItems,0)">50</ondown>
                <ondown>51</ondown>
            </control>
        </control>

        <!-- ============ RAILS ============ -->

        <control type="group">
            <left>0</left><top>820</top>

            <!-- Rail 1 : Continue Watching (Trakt) -->
