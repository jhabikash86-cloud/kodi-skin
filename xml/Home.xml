<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE for tools/gen_home.py, which fills in the scroll steps and the row list.
     Edit this file for the hero and the chrome; edit the generator for the rows. -->
<window>
    <defaultcontrol>8001</defaultcontrol>
    <menucontrol>9000</menucontrol>
    <controls>

        <!-- Hidden data list that feeds the hero ("top shelf"). Rotates every 10s. -->
        <control type="list" id="40">
            <left>0</left><top>1078</top><width>1740</width><height>2</height>
            <orientation>horizontal</orientation>
            <!-- Only rotates while you are idle, so the title never changes under your hands -->
            <autoscroll time="9000">System.IdleTime(5)</autoscroll>
            <itemlayout width="1" height="1" />
            <focusedlayout width="1" height="1" />
            <content limit="8">plugin://plugin.video.themoviedb.helper/?info=now_playing&amp;tmdb_type=movie&amp;nextpage=false</content>
        </control>

        <!-- ===================== FIXED BACKGROUND ===================== -->

        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0B0D">white.png</texture>
        </control>

        <!-- Hero backdrop: full bleed, slow Ken Burns drift, fades away when you move into the rows -->
        <control type="group">
            <animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>1080</height>
                <aspectratio align="center" aligny="top">scale</aspectratio>
                <fadetime>600</fadetime>
                <texture background="true">$INFO[Container(40).ListItem.Art(fanart)]</texture>
                <animation effect="zoom" start="100" end="107" center="960,400" time="22000" tween="linear" pulse="true" condition="true">Conditional</animation>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1300</width><height>1080</height>
                <texture>atv/grad_left.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>420</top><width>1920</width><height>660</height>
                <texture colordiffuse="FF0B0B0D">atv/grad_bottom.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>1920</width><height>240</height>
                <texture colordiffuse="B3FFFFFF">atv/grad_top.png</texture>
            </control>
        </control>

        <!-- ===== HERO =====
             Stays where it is and dims while the rows slide up over it (tvOS behaviour).
             Two elements moving at different speeds read as unsteady. -->
        <control type="group">
            <left>90</left><top>0</top>
            <animation effect="fade" start="100" end="0" time="300" tween="sine" easing="inout" condition="$EXP[ATV_RowsFocused]">Conditional</animation>

            <!-- Clear logo, or the title in bold if there's no logo -->
            <control type="image">
                <left>0</left><top>350</top><width>640</width><height>210</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <fadetime>400</fadetime>
                <texture background="true">$INFO[Container(40).ListItem.Art(clearlogo)]</texture>
                <visible>!String.IsEmpty(Container(40).ListItem.Art(clearlogo))</visible>
            </control>
            <control type="textbox">
                <left>0</left><top>390</top><width>1100</width><height>170</height>
                <label>$INFO[Container(40).ListItem.Title]</label>
                <font>atv_hero</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <visible>String.IsEmpty(Container(40).ListItem.Art(clearlogo))</visible>
            </control>

            <!-- Movie · 2025 · Thriller / Drama · ★ 7.8 -->
            <control type="label">
                <left>0</left><top>580</top><width>1100</width><height>34</height>
                <label>Movie$INFO[Container(40).ListItem.Year,  ·  ]$INFO[Container(40).ListItem.Genre,  ·  ]$INFO[Container(40).ListItem.Rating,  ·  ★ ]</label>
                <font>atv_meta</font>
                <textcolor>B3FFFFFF</textcolor>
            </control>
            <control type="textbox">
                <left>0</left><top>622</top><width>800</width><height>70</height>
                <label>$INFO[Container(40).ListItem.Plot]</label>
                <font>atv_body</font>
                <textcolor>D9FFFFFF</textcolor>
            </control>

            <!-- Play / More Info capsules. Left/right past the ends flips through the hero items. -->
            <control type="group">
                <left>0</left><top>722</top><width>206</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8001)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8001" />
                    <param name="width" value="206" />
                    <param name="label" value="Play" />
                    <param name="icon" value="atv/icon_play.png" />
                    <onclick>RunScript(special://skin/extras/play.py,movie,$INFO[Container(40).ListItem.UniqueID(tmdb)])</onclick>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>Control.Move(40,-1)</onleft>
                    <onright>8003</onright>
                </include>
            </control>
            <control type="group">
                <left>226</left><top>722</top><width>250</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8003)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8003" />
                    <param name="width" value="250" />
                    <param name="label" value="My List" />
                    <param name="icon" value="atv/icon_plus.png" />
                    <!-- Adds / removes the title on your Trakt watchlist -->
                    <onclick>RunScript(plugin.video.themoviedb.helper,sync_trakt,tmdb_type=movie,tmdb_id=$INFO[Container(40).ListItem.UniqueID(tmdb)],sync_type=watchlist)</onclick>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>8001</onleft>
                    <onright>8002</onright>
                </include>
            </control>
            <control type="group">
                <left>496</left><top>722</top><width>270</width><height>68</height>
                <animation effect="zoom" start="100" end="106" center="auto" time="220" tween="cubic" easing="out" condition="Control.HasFocus(8002)">Conditional</animation>
                <include content="ATV_CapsuleButton">
                    <param name="id" value="8002" />
                    <param name="width" value="270" />
                    <param name="label" value="More Info" />
                    <param name="align" value="center" />
                    <param name="textoffsetx" value="0" />
                                        <!-- Opens the Apple TV style title page for the hero item -->
                    <onclick>RunScript(special://skin/extras/details.py,open,40)</onclick>
                    <onup>9000</onup>
                    <ondown>50</ondown>
                    <onleft>8003</onleft>
                    <onright>Control.Move(40,1)</onright>
                </include>
            </control>

            <!-- Page dots for the hero carousel -->
            <control type="grouplist">
                <left>0</left><top>818</top><width>400</width><height>12</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor1]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,1)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor2]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,2)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor3]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,3)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor4]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,4)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor5]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,5)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor6]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,6)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor7]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,7)</visible></control>
                <control type="image"><width>10</width><height>10</height><texture colordiffuse="$VAR[ATV_DotColor8]">atv/dot.png</texture><visible>Integer.IsGreaterOrEqual(Container(40).NumItems,8)</visible></control>
            </control>
        </control>

        <!-- ===================== SCROLLING PAGE ===================== -->
        <control type="group" id="7000">
            <left>0</left><top>0</top>

            <!-- Page scroll, built from steps that add up rather than one absolute position
                 per row. Moving one row toggles exactly ONE of these, so nothing overlaps:
                 with absolute positions Kodi runs the old row's slide backwards while the new
                 one plays forward and adds them, which overshot badly with ease-out and
                 hesitated with a slow-start curve. The last rows share an offset, so the page
                 stops with the final row at the bottom.
                 Totals: 50 -710, 51 -1090, 52 -1490, 53 -1890, 54 -2290, 55 -2690, 56 -3090, 57 -3490, 58 -3840, 59 -3840 -->
            <animation effect="slide" end="0,-710" time="380" tween="sine" easing="inout" condition="Control.HasFocus(50) | ControlGroup(51).HasFocus(0) | ControlGroup(52).HasFocus(0) | Control.HasFocus(53) | ControlGroup(54).HasFocus(0) | ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-380" time="380" tween="sine" easing="inout" condition="!$EXP[ATV_UpNextEmpty] + [ControlGroup(51).HasFocus(0) | ControlGroup(52).HasFocus(0) | Control.HasFocus(53) | ControlGroup(54).HasFocus(0) | ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)]">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="ControlGroup(52).HasFocus(0) | Control.HasFocus(53) | ControlGroup(54).HasFocus(0) | ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="Control.HasFocus(53) | ControlGroup(54).HasFocus(0) | ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="ControlGroup(54).HasFocus(0) | ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="ControlGroup(55).HasFocus(0) | ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="ControlGroup(56).HasFocus(0) | Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-400" time="380" tween="sine" easing="inout" condition="Control.HasFocus(57) | Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>
            <animation effect="slide" end="0,-350" time="380" tween="sine" easing="inout" condition="Control.HasFocus(58) | Control.HasFocus(59)">Conditional</animation>

            <!-- ===== ROWS ===== -->
            <!-- trakt_ondeck is "continue watching": the episodes you actually paused, newest
                 pause first. trakt_nextepisodes looks tidier (one row per show) but only lists
                 shows you have FINISHED an episode of, which dropped most of the row. -->
            <include content="ATV_UpNextRow">
                <param name="id" value="50" />
                <param name="top" value="860" />
                <param name="label" value="Continue Watching" />
                <param name="onup" value="8001" />
                <param name="ondown" value="51" />
                <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_ondeck&amp;tmdb_type=tv&amp;nextpage=false" />
            </include>

            <control type="group">
                <animation effect="slide" end="0,-380" time="400" tween="quadratic" easing="inout" condition="$EXP[ATV_UpNextEmpty]">Conditional</animation>
                <include content="ATV_RankRow">
                    <param name="id" value="51" />
                    <param name="idbase" value="61" />
                    <param name="data" value="6051" />
                    <param name="top" value="1240" />
                    <param name="label" value="Top 10 Movies Right Now" />
                    <param name="onup" value="50" />
                    <param name="ondown" value="52" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_trending&amp;tmdb_type=movie&amp;nextpage=false" />
                </include>
                <include content="ATV_RankRow">
                    <param name="id" value="52" />
                    <param name="idbase" value="62" />
                    <param name="data" value="6052" />
                    <param name="top" value="1640" />
                    <param name="label" value="Top 10 Shows Right Now" />
                    <param name="onup" value="51" />
                    <param name="ondown" value="53" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_trending&amp;tmdb_type=tv&amp;nextpage=false" />
                </include>
                <include content="ATV_PosterRow">
                    <param name="id" value="53" />
                    <param name="top" value="2040" />
                    <param name="label" value="Recommended for You" />
                    <param name="onup" value="52" />
                    <param name="ondown" value="54" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=trakt_recommendations&amp;tmdb_type=movie&amp;nextpage=false" />
                </include>
                <include content="ATV_RankRow">
                    <param name="id" value="54" />
                    <param name="idbase" value="63" />
                    <param name="data" value="6054" />
                    <param name="top" value="2440" />
                    <param name="label" value="Top 10 on Netflix" />
                    <param name="onup" value="53" />
                    <param name="ondown" value="55" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_watch_providers=8&amp;watch_region=IN&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=20&amp;nextpage=false" />
                </include>
                <include content="ATV_RankRow">
                    <param name="id" value="55" />
                    <param name="idbase" value="64" />
                    <param name="data" value="6055" />
                    <param name="top" value="2840" />
                    <param name="label" value="Top 10 on Prime Video" />
                    <param name="onup" value="54" />
                    <param name="ondown" value="56" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_watch_providers=119&amp;watch_region=IN&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=20&amp;nextpage=false" />
                </include>
                <include content="ATV_RankRow">
                    <param name="id" value="56" />
                    <param name="idbase" value="65" />
                    <param name="data" value="6056" />
                    <param name="top" value="3240" />
                    <param name="label" value="Top 10 on JioHotstar" />
                    <param name="onup" value="55" />
                    <param name="ondown" value="57" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_watch_providers=2336&amp;watch_region=IN&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=20&amp;nextpage=false" />
                </include>
                <include content="ATV_PosterRow">
                    <param name="id" value="57" />
                    <param name="top" value="3640" />
                    <param name="label" value="Trending in Hindi" />
                    <param name="onup" value="56" />
                    <param name="ondown" value="58" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_original_language=hi&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=15&amp;nextpage=false" />
                </include>
                <include content="ATV_PosterRow">
                    <param name="id" value="58" />
                    <param name="top" value="4040" />
                    <param name="label" value="Trending in Tamil" />
                    <param name="onup" value="57" />
                    <param name="ondown" value="59" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_original_language=ta&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=10&amp;nextpage=false" />
                </include>
                <include content="ATV_PosterRow">
                    <param name="id" value="59" />
                    <param name="top" value="4440" />
                    <param name="label" value="World Cinema" />
                    <param name="onup" value="58" />
                    <param name="content" value="plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=movie&amp;with_origin_country=KR%7CJP%7CFR%7CES%7CIT&amp;sort_by=popularity.desc&amp;primary_release_date.gte=2025-03-31&amp;vote_count.gte=30&amp;nextpage=false" />
                </include>
            </control>
        </control>

        <!-- Rows above the focused one dissolve into the top edge instead of being cut off -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>190</height>
            <texture>atv/grad_top.png</texture>
            <visible>$EXP[ATV_RowsFocused]</visible>
            <animation effect="fade" time="300">VisibleChange</animation>
        </control>

        <include content="ATV_TabBar">
            <param name="hidewhen" value="$EXP[ATV_RowsFocused]" />
            <param name="ondown" value="8001" />
        </include>

    </controls>
</window>
