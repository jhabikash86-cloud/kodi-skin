<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0B0B0D">white.png</texture>
        </control>

        <control type="label" id="2">
            <left>90</left>
            <top>40</top>
            <width>1200</width>
            <height>70</height>
            <font>font27</font>
            <textcolor>FFFFFFFF</textcolor>
            <aligny>center</aligny>
        </control>

        <!-- Categories. Kodi fills this. -->
        <control type="grouplist" id="3">
            <description>category buttons</description>
            <left>90</left>
            <top>130</top>
            <width>420</width>
            <height>800</height>
            <itemgap>4</itemgap>
            <orientation>vertical</orientation>
            <scrolltime>200</scrolltime>
            <onright>5</onright>
        </control>

        <!-- Setting rows. Kodi fills this. -->
        <control type="grouplist" id="5">
            <description>settings controls</description>
            <left>540</left>
            <top>130</top>
            <width>1280</width>
            <height>800</height>
            <itemgap>2</itemgap>
            <orientation>vertical</orientation>
            <scrolltime>200</scrolltime>
            <onleft>3</onleft>
            <pagecontrol>60</pagecontrol>
        </control>

        <control type="scrollbar" id="60">
            <left>1848</left>
            <top>130</top>
            <width>6</width>
            <height>800</height>
            <texturesliderbackground colordiffuse="22FFFFFF">white.png</texturesliderbackground>
            <texturesliderbar colordiffuse="66FFFFFF">white.png</texturesliderbar>
            <texturesliderbarfocus colordiffuse="FFFFFFFF">white.png</texturesliderbarfocus>
            <textureslidernib>-</textureslidernib>
            <textureslidernibfocus>-</textureslidernibfocus>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
        </control>

        <control type="button" id="20">
            <left>90</left>
            <top>980</top>
            <width>400</width>
            <height>50</height>
            <label>$INFO[System.SettingsLevel]</label>
            <font>font16</font>
            <textcolor>B3FFFFFF</textcolor>
            <focusedcolor>FFFFFFFF</focusedcolor>
            <align>left</align>
            <aligny>center</aligny>
            <texturefocus>-</texturefocus>
            <texturenofocus>-</texturenofocus>
        </control>

        <!-- Hidden templates. Do not put these inside grouplist 3 or 5. -->
        <control type="group">
            <visible>false</visible>
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>

            <control type="button" id="7">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <disabledcolor>66FFFFFF</disabledcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
            </control>

            <control type="radiobutton" id="8">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <disabledcolor>66FFFFFF</disabledcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
                <textureradioonfocus colordiffuse="FF0B0B0D">white.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">white.png</textureradioonnofocus>
                <textureradioofffocus colordiffuse="33000000">white.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="33FFFFFF">white.png</textureradiooffnofocus>
                <radiowidth>28</radiowidth>
                <radioheight>28</radioheight>
                <textoffsetx>24</textoffsetx>
            </control>

            <control type="spincontrolex" id="9">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <disabledcolor>66FFFFFF</disabledcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
                <spinwidth>32</spinwidth>
                <spinheight>32</spinheight>
            </control>

            <control type="button" id="10">
                <width>420</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>99FFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="22FFFFFF">white.png</texturefocus>
                <texturenofocus>-</texturenofocus>
            </control>

            <control type="image" id="11">
                <width>1280</width>
                <height>12</height>
                <texture colordiffuse="1AFFFFFF">white.png</texture>
            </control>

            <control type="edit" id="12">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <disabledcolor>66FFFFFF</disabledcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
            </control>

            <control type="sliderex" id="13">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <disabledcolor>66FFFFFF</disabledcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
            </control>

            <control type="rangecontrol" id="14">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
            </control>

            <control type="colorbutton" id="15">
                <width>1280</width>
                <height>70</height>
                <font>font16</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0B0B0D</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="E6FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="14FFFFFF">white.png</texturenofocus>
            </control>
        </control>
    </controls>
</window>
