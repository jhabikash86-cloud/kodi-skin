	<expression name="ATV_DetailNoSeasons3">$EXP[ATV_DetailIsTV3] + $EXP[ATV_DetailReady3] + Integer.IsEqual(Container(9610).NumItems,0) + !Container(9610).IsUpdating</expression>
	<variable name="ATV_DetailMeta3">
		<value condition="$EXP[ATV_DetailIsTV3]">TV Show$INFO[Container(9500).ListItem.Year,  ·  ]$INFO[Container(9500).ListItem.Genre,  ·  ]$INFO[Container(9500).ListItem.MPAA,  ·  ]$INFO[Container(9500).ListItem.Rating,  ·  ★ ]</value>
		<value>Movie$INFO[Container(9500).ListItem.Year,  ·  ]$INFO[Container(9500).ListItem.Genre,  ·  ]$INFO[Container(9500).ListItem.Duration(mins),  ·  , min]$INFO[Container(9500).ListItem.MPAA,  ·  ]$INFO[Container(9500).ListItem.Rating,  ·  ★ ]</value>
	</variable>
	<!-- extras/details.py fills DetailNext3 just after the page opens ("Play S1 E4" or
	     "Resume S1 E3"), so the button names the episode Play will actually start. Until
	     that lands - and for films - it just says Play. -->
	<variable name="ATV_DetailPlayLabel3">
		<value condition="!String.IsEmpty(Skin.String(DetailNext3))">$INFO[Skin.String(DetailNext3)]</value>
		<value>Play</value>
	</variable>

	<!-- ===== Title page 4 (window 1134) ===== -->
	<expression name="ATV_DetailIsTV4">String.IsEqual(Skin.String(DetailType4),tv)</expression>
	<variable name="ATV_DetailPath4">
		<value>plugin://plugin.video.themoviedb.helper/?info=details&amp;tmdb_type=$INFO[Skin.String(DetailType4)]&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;nextpage=false</value>
	</variable>
	<!-- The details listing is this title's, not the one this page showed last. Kodi keeps a
	     page's previous listing and shows it until the new one lands, so everything read
	     from Container(9500) waits on this. -->
	<expression name="ATV_DetailReady4">String.IsEqual(Container(9500).ListItem.UniqueID(tmdb),Skin.String(DetailID4)) + !Container(9500).IsUpdating</expression>
	<!-- Until then the page shows the tile that was clicked: extras/details.py copies its
	     backdrop, logo and title across before opening the page, so it opens on the right
	     picture instead of the last title's. The URLs are the same ones the details bring,
	     so nothing is fetched twice. -->
	<variable name="ATV_DetailFanart4">
		<value condition="$EXP[ATV_DetailReady4] + !String.IsEmpty(Container(9500).ListItem.Art(fanart))">$INFO[Container(9500).ListItem.Art(fanart)]</value>
		<value>$INFO[Skin.String(DetailFanart4)]</value>
	</variable>
	<variable name="ATV_DetailLogo4">
		<value condition="$EXP[ATV_DetailReady4] + !String.IsEmpty(Container(9500).ListItem.Art(clearlogo))">$INFO[Container(9500).ListItem.Art(clearlogo)]</value>
		<value>$INFO[Skin.String(DetailLogo4)]</value>
	</variable>
	<expression name="ATV_DetailHasLogo4">[$EXP[ATV_DetailReady4] + !String.IsEmpty(Container(9500).ListItem.Art(clearlogo))] | !String.IsEmpty(Skin.String(DetailLogo4))</expression>
	<variable name="ATV_DetailTitle4">
		<value condition="$EXP[ATV_DetailReady4]">$INFO[Container(9500).ListItem.Title]</value>
		<value>$INFO[Skin.String(DetailTitle4)]</value>
	</variable>
	<!-- More Like This: same genres, and the same language, so a Tamil film leads to more
	     Tamil cinema. extras/details.py composes the filter from this title's own details
	     once they land - the tile that was clicked can carry only its first genre, and
	     "Comedy" alone turned an R-rated horror comedy into Toy Story and PAW Patrol. Empty
	     until then, so the row fetches once, for the right title. "similar" means the
	     details had no genres to go on. -->
	<variable name="ATV_DetailGenrePath4">
		<value condition="String.IsEqual(Skin.String(DetailDiscover4),similar)">plugin://plugin.video.themoviedb.helper/?info=similar&amp;tmdb_type=$INFO[Skin.String(DetailType4)]&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;hide_unaired=true&amp;nextpage=false</value>
		<value condition="!String.IsEmpty(Skin.String(DetailDiscover4))">plugin://plugin.video.themoviedb.helper/?info=discover&amp;tmdb_type=$INFO[Skin.String(DetailType4)]&amp;$INFO[Skin.String(DetailDiscover4)]&amp;exclude_key=tmdb_id&amp;exclude_value=$INFO[Skin.String(DetailID4)]&amp;exclude_operator=eq&amp;hide_unaired=true&amp;nextpage=false</value>
	</variable>
	<!-- Everything below waits for this title's details. TMDb Helper locks a title while it
	     builds its details, and every list about that title - seasons, episodes, cast,
	     recommendations - waits on the same lock and, when it gets it, fetches the details
	     again for itself. Opened all at once they queued up past the lock's 10s limit, and
	     the last in line failed with a TMDb Helper error - a page with no episodes, or no
	     rows at all. Once the details are in, each of these reads them from the cache and
	     holds the lock for a moment. Empty for movies, so the hidden season rows never ask. -->
	<variable name="ATV_SeasonsPath4">
		<value condition="$EXP[ATV_DetailIsTV4] + $EXP[ATV_DetailReady4]">plugin://plugin.video.themoviedb.helper/?info=seasons&amp;tmdb_type=tv&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;exclude_key=season&amp;exclude_value=-1&amp;exclude_operator=eq&amp;nextpage=false</value>
	</variable>
	<variable name="ATV_EpisodesPath4">
		<value condition="$EXP[ATV_DetailIsTV4] + $EXP[ATV_DetailReady4]">plugin://plugin.video.themoviedb.helper/?info=episodes&amp;tmdb_type=tv&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;season=$VAR[ATV_DetailSeason]&amp;nextpage=false</value>
	</variable>
	<variable name="ATV_CastPath4">
		<value condition="$EXP[ATV_DetailReady4]">plugin://plugin.video.themoviedb.helper/?info=cast&amp;tmdb_type=$INFO[Skin.String(DetailType4)]&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;nextpage=false</value>
	</variable>
	<variable name="ATV_RecommendedPath4">
		<value condition="$EXP[ATV_DetailReady4]">plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=$INFO[Skin.String(DetailType4)]&amp;tmdb_id=$INFO[Skin.String(DetailID4)]&amp;hide_unaired=true&amp;nextpage=false</value>
	</variable>
	<!-- A show TMDb has no seasons for yet - announced, not aired -->
	<expression name="ATV_DetailNoSeasons4">$EXP[ATV_DetailIsTV4] + $EXP[ATV_DetailReady4] + Integer.IsEqual(Container(9610).NumItems,0) + !Container(9610).IsUpdating</expression>
	<variable name="ATV_DetailMeta4">
		<value condition="$EXP[ATV_DetailIsTV4]">TV Show$INFO[Container(9500).ListItem.Year,  ·  ]$INFO[Container(9500).ListItem.Genre,  ·  ]$INFO[Container(9500).ListItem.MPAA,  ·  ]$INFO[Container(9500).ListItem.Rating,  ·  ★ ]</value>
		<value>Movie$INFO[Container(9500).ListItem.Year,  ·  ]$INFO[Container(9500).ListItem.Genre,  ·  ]$INFO[Container(9500).ListItem.Duration(mins),  ·  , min]$INFO[Container(9500).ListItem.MPAA,  ·  ]$INFO[Container(9500).ListItem.Rating,  ·  ★ ]</value>
	</variable>
	<!-- extras/details.py fills DetailNext4 just after the page opens ("Play S1 E4" or
	     "Resume S1 E3"), so the button names the episode Play will actually start. Until
	     that lands - and for films - it just says Play. -->
	<variable name="ATV_DetailPlayLabel4">
		<value condition="!String.IsEmpty(Skin.String(DetailNext4))">$INFO[Skin.String(DetailNext4)]</value>
		<value>Play</value>
	</variable>
</includes>
