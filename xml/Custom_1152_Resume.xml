					<texture colordiffuse="FFFFFFFF">white.png</texture>
					<visible>Integer.IsGreaterOrEqual(Window(home).Property(ATVResumePercent),98)</visible>
				</control>
			</control>
			<control type="label">
				<left>0</left><top>196</top><width>1200</width><height>40</height>
				<label>$INFO[Window(home).Property(ATVResumeDetail)]</label>
				<font>atv_small</font><textcolor>99FFFFFF</textcolor>
			</control>

			<control type="group">
				<top>280</top><width>620</width><height>84</height>
				<include content="ATV_CapsuleButton">
					<param name="id" value="9180" />
					<param name="width" value="620" />
					<param name="label" value="Resume from $INFO[Window(home).Property(ATVResumeFrom)]" />
					<param name="icon" value="atv/icon_play.png" />
					<onclick>SetProperty(ATVResumeChoice,resume,home)</onclick>
					<onclick>Dialog.Close(1152,true)</onclick>
					<ondown>9181</ondown>
					<onup>noop</onup>
				</include>
			</control>
			<control type="group">
				<top>376</top><width>620</width><height>84</height>
				<include content="ATV_CapsuleButton">
					<param name="id" value="9181" />
					<param name="width" value="620" />
					<param name="label" value="Play from Beginning" />
					<onclick>SetProperty(ATVResumeChoice,start,home)</onclick>
					<onclick>Dialog.Close(1152,true)</onclick>
					<onup>9180</onup>
					<ondown>noop</ondown>
				</include>
			</control>
		</control>
	</controls>
</window>
