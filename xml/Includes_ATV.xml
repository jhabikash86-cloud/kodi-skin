					</include>
					<include content="ATV_Tab">
						<param name="id" value="9002" /><param name="width" value="140" /><param name="label" value="Movies" />
						<param name="textcolor" value="$VAR[ATV_TabColorMovies]" />
						<param name="nofocus" value="$VAR[ATV_TabPillMovies]" />
						<param name="onclick" value="ReplaceWindow(1140)" />
					</include>
					<include content="ATV_Tab">
						<param name="id" value="9003" /><param name="width" value="164" /><param name="label" value="TV Shows" />
						<param name="textcolor" value="$VAR[ATV_TabColorTV]" />
						<param name="nofocus" value="$VAR[ATV_TabPillTV]" />
						<param name="onclick" value="ReplaceWindow(1141)" />
					</include>
					<include content="ATV_Tab">
						<param name="id" value="9004" /><param name="width" value="136" /><param name="label" value="Search" />
