<?xml version="1.0" encoding="UTF-8"?>
<!-- ATV Minimal: Apple TV style building blocks shared by Home and Search -->
<includes>

	<!-- ===================== EXPRESSIONS ===================== -->

	<expression name="ATV_RowsFocused">Control.HasFocus(50) | Control.HasFocus(51) | ControlGroup(52).HasFocus(0) | ControlGroup(53).HasFocus(0) | Control.HasFocus(54) | Control.HasFocus(55) | ControlGroup(56).HasFocus(0) | ControlGroup(57).HasFocus(0) | ControlGroup(58).HasFocus(0) | Control.HasFocus(59) | Control.HasFocus(60) | Control.HasFocus(61)</expression>
	<!-- A hero trailer is on screen: everything over it fades so it plays full-screen, as on
	     Apple TV; any press stops the preview (extras/trailer.py) and brings it all back. -->
	<expression name="ATV_TrailerFull">!String.IsEmpty(Window(home).Property(ATVPreview)) + !String.IsEmpty(Window(home).Property(ATVPreviewShape)) + Player.HasVideo</expression>
	<!-- The hero before its list has loaded: the first item as it was last time, saved by
	     extras/prefetch.py - so Home opens on a picture, as Apple TV's top shelf does,
	     instead of a dark screen for the second or two a cold start takes. -->
	<expression name="ATV_HeroLoaded">Integer.IsGreater(Container(40).NumItems,0)</expression>
	<expression name="ATV_HeroHasLogo">[$EXP[ATV_HeroLoaded] + !String.IsEmpty(Container(40).ListItem.Art(clearlogo))] | [!$EXP[ATV_HeroLoaded] + !String.IsEmpty(Skin.String(ATVHero.clearlogo))]</expression>
	<variable name="ATV_HeroFanart">
		<value condition="$EXP[ATV_HeroLoaded]">$INFO[Container(40).ListItem.Art(fanart)]</value>
		<value>$INFO[Skin.String(ATVHero.fanart)]</value>
	</variable>
	<variable name="ATV_HeroLogo">
		<value condition="$EXP[ATV_HeroLoaded]">$INFO[Container(40).ListItem.Art(clearlogo)]</value>
		<value>$INFO[Skin.String(ATVHero.clearlogo)]</value>
	</variable>
	<variable name="ATV_HeroTitle">
		<value condition="$EXP[ATV_HeroLoaded]">$INFO[Container(40).ListItem.Title]</value>
		<value>$INFO[Skin.String(ATVHero.title)]</value>
	</variable>
	<variable name="ATV_HeroMeta">
		<value condition="$EXP[ATV_HeroLoaded]">Movie$INFO[Container(40).ListItem.Year,  ·  ]$INFO[Container(40).ListItem.Genre,  ·  ]$INFO[Container(40).ListItem.Rating,  ·  ★ ]</value>
		<value>$INFO[Skin.String(ATVHero.meta)]</value>
	</variable>
	<variable name="ATV_HeroPlot">
		<value condition="$EXP[ATV_HeroLoaded]">$INFO[Container(40).ListItem.Plot]</value>
		<value>$INFO[Skin.String(ATVHero.plot)]</value>
	</variable>
	<!-- The tab bar shows only while it has focus: Up at the top of a page, or Back -->
	<expression name="ATV_TabBarHidden">!ControlGroup(9000).HasFocus()</expression>
	<expression name="ATV_UpNextEmpty">Integer.IsEqual(Container(50).NumItems,0)</expression>

	<!-- ===================== VARIABLES ===================== -->

	<variable name="ATV_LandscapeArt">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.landscape))">$INFO[ListItem.Art(tvshow.landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>

	<!-- Ambient backdrop behind the rows: fanart of whatever tile is focused -->

	<!-- TMDb Helper people carry their photo as profile/poster, not thumb -->
	<variable name="ATV_PersonArt">
		<value condition="!String.IsEmpty(ListItem.Art(profile))">$INFO[ListItem.Art(profile)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="ATV_SearchFanart">
		<value condition="Control.HasFocus(8120)">$INFO[Container(8120).ListItem.Art(fanart)]</value>
		<value condition="Control.HasFocus(8130)">$INFO[Container(8130).ListItem.Art(fanart)]</value>
	</variable>

	<!-- ===================== ANIMATIONS ===================== -->

	<!-- tvOS "lift": tile grows and gains a soft shadow when focused -->
	<include name="ATV_Lift">
		<param name="center">auto</param>
		<param name="zoom">108</param>
		<definition>
			<animation effect="zoom" start="100" end="$PARAM[zoom]" center="$PARAM[center]" time="220" tween="cubic" easing="out">Focus</animation>
			<animation effect="zoom" start="$PARAM[zoom]" end="100" center="$PARAM[center]" time="180" tween="cubic" easing="out">Unfocus</animation>
		</definition>
	</include>

	<!-- ===================== ROWS ===================== -->

	<!-- Row of 2:3 posters (200x300 tiles) -->
	<!-- Home's "Because You Watched": recommendations for the last film in the hidden history
	     list (6070). Empty until that list has an id - as a plain path it was requested at
	     startup with tmdb_id= blank, which fails. -->
	<variable name="ATV_BecauseYouWatchedPath">
		<value condition="!String.IsEmpty(Container(6070).ListItem.UniqueID(tmdb))">plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=movie&amp;tmdb_id=$INFO[Container(6070).ListItem.UniqueID(tmdb)]&amp;hide_unaired=true&amp;nextpage=false</value>
	</variable>

	<variable name="ATV_UpNextSubtitle">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season,Season ,  ·  ]$INFO[ListItem.Episode,Episode ]</value>
		<value>Movie$INFO[ListItem.Year,  ·  ]</value>
	</variable>

	<include name="ATV_PosterRow">
		<param name="id" />
		<param name="top" />
		<param name="label" />
		<param name="content" />
		<param name="onup" />
		<param name="ondown">noop</param>
		<param name="onback">SetFocus(8001)</param>
		<!-- A condition that is true while the row still shows someone else's items. A title
		     page keeps its last listing in memory and shows it until the new one lands, so
		     without this "More Like This" spends a second or three recommending for the
		     previous title. Title pages pass Container(id).IsUpdating; everywhere else a row
		     never goes stale, and a row that blinked out on every refresh would be worse. -->
		<param name="stale">false</param>
		<!-- Where Up goes instead when altup is true - past a row that has nothing in it -->
		<param name="altup">false</param>
		<param name="altupto">noop</param>
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<control type="label">
					<left>90</left><top>0</top><width>1400</width><height>44</height>
					<label>$PARAM[label]</label>
					<font>atv_row</font>
					<textcolor>FFFFFFFF</textcolor>
				</control>
				<!-- What is focused, on the row's own header line. There is no room for a
				     caption under a poster without pushing the rows apart, and the artwork
				     already carries the title - this is for the year and the rating. -->
				<control type="label">
					<left>1020</left><top>0</top><width>810</width><height>44</height>
					<label>$INFO[Container($PARAM[id]).ListItem.Title]$INFO[Container($PARAM[id]).ListItem.Year,  ·  ]$INFO[Container($PARAM[id]).ListItem.Rating,  ·  ★ ]</label>
					<font>atv_meta</font>
					<textcolor>99FFFFFF</textcolor>
					<align>right</align><aligny>center</aligny>
					<visible>Control.HasFocus($PARAM[id])</visible>
					<animation effect="fade" time="200">VisibleChange</animation>
				</control>
								<!-- Placeholders while the row loads, so it never sits empty -->
				<control type="group">
					<visible>Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[stale]</visible>
					<animation effect="fade" start="100" end="0" delay="1000" time="300" condition="Integer.IsEqual(Container($PARAM[id]).NumItems,0) + !Container($PARAM[id]).IsUpdating + !$PARAM[stale]">Conditional</animation>
					<animation effect="fade" start="100" end="45" time="900" pulse="true" condition="true">Conditional</animation>
					<animation effect="fade" time="250">VisibleChange</animation>
				<control type="image">
					<left>90</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>372</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>654</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>936</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>1218</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>1500</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>1782</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				<control type="image">
					<left>2064</left><top>64</top><width>250</width><height>375</height>
					<texture colordiffuse="14FFFFFF" diffuse="atv/mask_poster.png">white.png</texture>
				</control>
				</control>
				<!-- A row that finished loading with nothing in it says so, rather than pulsing
				     placeholders forever as though it were still loading -->
				<control type="label">
					<left>90</left><top>64</top><width>1400</width><height>60</height>
					<label>Nothing here yet</label>
					<font>atv_meta</font><textcolor>66FFFFFF</textcolor>
					<visible>Integer.IsEqual(Container($PARAM[id]).NumItems,0) + !Container($PARAM[id]).IsUpdating + !$PARAM[stale]</visible>
					<!-- after a second, so a row just starting to load never flashes it -->
					<animation effect="fade" start="0" end="100" delay="1000" time="300">Visible</animation>
				</control>
				<control type="list" id="$PARAM[id]">
					<left>70</left><top>34</top><width>1850</width><height>455</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">420</scrolltime>
					<preloaditems>2</preloaditems>
					<animation effect="fade" start="100" end="0" time="180" condition="$PARAM[stale]">Conditional</animation>
					<onup condition="!$PARAM[altup]">$PARAM[onup]</onup>
					<onup condition="$PARAM[altup]">$PARAM[altupto]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onback>$PARAM[onback]</onback>
					<onclick>RunScript(special://skin/extras/details.py,open,$PARAM[id])</onclick>
					<itemlayout width="282" height="455">
						<control type="image">
							<left>16</left><top>30</top><width>250</width><height>375</height>
							<texture colordiffuse="FF1C1C1E" diffuse="atv/mask_poster.png">white.png</texture>
						</control>
						<control type="label">
							<left>32</left><top>30</top><width>218</width><height>375</height>
							<label>$INFO[ListItem.Label]</label>
							<font>atv_caption</font><textcolor>B3FFFFFF</textcolor>
							<align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
							<visible>String.IsEmpty(ListItem.Art(poster))</visible>
						</control>
						<control type="image">
							<left>16</left><top>30</top><width>250</width><height>375</height>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<fadetime>200</fadetime>
							<texture background="true" diffuse="atv/mask_poster.png">$INFO[ListItem.Art(poster)]</texture>
						</control>
						<!-- Watched, straight from Trakt -->
						<control type="image">
							<left>16</left><top>30</top><width>250</width><height>375</height>
							<texture colordiffuse="59000000" diffuse="atv/mask_poster.png">white.png</texture>
							<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
						</control>
						<control type="image">
							<left>206</left><top>42</top><width>46</width><height>46</height>
							<texture colordiffuse="E6000000" diffuse="atv/mask_circle.png">white.png</texture>
							<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
						</control>
						<control type="image">
							<left>216</left><top>52</top><width>26</width><height>26</height>
							<texture colordiffuse="FFFFFFFF">atv/icon_check.png</texture>
							<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
						</control>
					</itemlayout>
					<focusedlayout width="282" height="455">
						<control type="group">
							<!-- Apple TV's focus: the poster comes forward - 14% larger, lifted a little, over a
								     deeper shadow - rather than a highlight moving across it -->
							<!-- Anchored a third of the way down the poster, so it grows mostly downward: from
							     the middle, its top edge reached the row title above it -->
							<include content="ATV_Lift"><param name="center" value="141,161" /><param name="zoom" value="114" /></include>
							<animation effect="slide" start="0,0" end="0,-4" time="220" tween="cubic" easing="out">Focus</animation>
							<animation effect="slide" start="0,-4" end="0,0" time="180" tween="cubic" easing="out">Unfocus</animation>
							<control type="image">
								<left>-30</left><top>-2</top><width>342</width><height>470</height>
								<texture border="64">atv/shadow.png</texture>
								<animation effect="fade" start="0" end="100" time="220">Focus</animation>
								<animation effect="fade" start="100" end="0" time="160">Unfocus</animation>
							</control>
							<control type="image">
								<left>16</left><top>30</top><width>250</width><height>375</height>
								<texture colordiffuse="FF1C1C1E" diffuse="atv/mask_poster.png">white.png</texture>
							</control>
							<control type="label">
								<left>32</left><top>30</top><width>218</width><height>375</height>
								<label>$INFO[ListItem.Label]</label>
								<font>atv_caption</font><textcolor>FFFFFFFF</textcolor>
								<align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
								<visible>String.IsEmpty(ListItem.Art(poster))</visible>
							</control>
							<control type="image">
								<left>16</left><top>30</top><width>250</width><height>375</height>
								<aspectratio scalediffuse="false">scale</aspectratio>
								<fadetime>200</fadetime>
								<texture background="true" diffuse="atv/mask_poster.png">$INFO[ListItem.Art(poster)]</texture>
							</control>
							<!-- A thin light edge that lifts the poster off the black -->
							<control type="image">
								<left>16</left><top>30</top><width>250</width><height>375</height>
								<texture border="16" colordiffuse="33FFFFFF">atv/ring16.png</texture>
								<animation effect="fade" start="0" end="100" time="220">Focus</animation>
							</control>
							<!-- Watched, straight from Trakt -->
							<control type="image">
								<left>16</left><top>30</top><width>250</width><height>375</height>
								<texture colordiffuse="59000000" diffuse="atv/mask_poster.png">white.png</texture>
								<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
							</control>
							<control type="image">
								<left>206</left><top>42</top><width>46</width><height>46</height>
								<texture colordiffuse="E6000000" diffuse="atv/mask_circle.png">white.png</texture>
								<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
							</control>
							<control type="image">
								<left>216</left><top>52</top><width>26</width><height>26</height>
								<texture colordiffuse="FFFFFFFF">atv/icon_check.png</texture>
								<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
							</control>
						</control>
					</focusedlayout>
					<content>$PARAM[content]</content>
				</control>
			</control>
		</definition>
	</include>

	<!-- Up Next row: 16:9 tiles with progress bar, title and episode line underneath -->
	<include name="ATV_UpNextTile">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<left>20</left><top>30</top><width>384</width><height>216</height>
				<texture colordiffuse="FF1C1C1E" diffuse="atv/mask_landscape.png">white.png</texture>
			</control>
			<control type="image">
				<left>20</left><top>30</top><width>384</width><height>216</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="atv/mask_landscape.png">$VAR[ATV_LandscapeArt]</texture>
			</control>
			<control type="image">
				<left>20</left><top>138</top><width>384</width><height>108</height>
				<texture diffuse="atv/mask_landscape.png" colordiffuse="B3FFFFFF">atv/grad_bottom.png</texture>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="progress">
				<left>40</left><top>222</top><width>344</width><height>6</height>
				<info>ListItem.PercentPlayed</info>
				<texturebg border="3,0,3,0" colordiffuse="4DFFFFFF">atv/bar6.png</texturebg>
				<midtexture border="3,0,3,0" colordiffuse="FFFFFFFF">atv/bar6.png</midtexture>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="label">
				<left>20</left><top>262</top><width>384</width><height>32</height>
				<label>$VAR[ATV_UpNextTitle]</label>
				<font>atv_caption</font>
				<textcolor>FFFFFFFF</textcolor>
				<scroll>$PARAM[focused]</scroll>
			</control>
			<control type="label">
				<left>20</left><top>294</top><width>384</width><height>30</height>
				<!-- An episode says which one; a film says it is a film and its year -->
				<label>$VAR[ATV_UpNextSubtitle]</label>
				<font>atv_small</font>
				<textcolor>99FFFFFF</textcolor>
			</control>
		</definition>
	</include>
	<variable name="ATV_UpNextTitle">
		<value condition="!String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<include name="ATV_UpNextRow">
		<param name="id" />
		<param name="top" />
		<param name="label" />
		<param name="content" />
		<!-- One list per row. Two <content> lists in one row froze Kodi: its multi-list
		     provider takes the list lock under the graphics lock, while a finished load holds
		     the list lock and waits for the graphics lock to free the old artwork. -->
		<param name="empty">$EXP[ATV_UpNextEmpty]</param>
		<param name="onup" />
		<param name="ondown" />
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<control type="label">
					<left>90</left><top>0</top><width>1400</width><height>44</height>
					<label>$PARAM[label]</label>
					<font>atv_row</font>
					<textcolor>FFFFFFFF</textcolor>
					<visible>!$PARAM[empty]</visible>
				</control>
				<control type="list" id="$PARAM[id]">
					<left>70</left><top>34</top><width>1850</width><height>340</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">420</scrolltime>
					<preloaditems>2</preloaditems>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onback>SetFocus(8001)</onback>
					<!-- This row exists to pick something back up, so clicking resumes it.
					     The show's page is still a context-menu away. -->
					<onclick>RunScript(special://skin/extras/play.py,item,$PARAM[id])</onclick>
					<itemlayout width="416" height="340">
						<include content="ATV_UpNextTile" />
					</itemlayout>
					<focusedlayout width="416" height="340">
						<control type="group">
							<include content="ATV_Lift"><param name="center" value="212,138" /><param name="zoom" value="106" /></include>
							<control type="image">
								<left>-24</left><top>-4</top><width>472</width><height>290</height>
								<texture border="64">atv/shadow.png</texture>
								<animation effect="fade" start="0" end="100" time="220">Focus</animation>
								<animation effect="fade" start="100" end="0" time="160">Unfocus</animation>
							</control>
							<include content="ATV_UpNextTile"><param name="focused" value="true" /></include>
						</control>
					</focusedlayout>
					<!-- No sortby: Trakt already lists it newest first -->
					<!-- Tells the context menu it was opened on Continue Watching (see DialogContextMenu.xml) -->
					<onfocus>SetProperty(ATVContinueFocus,1,home)</onfocus>
					<onunfocus>ClearProperty(ATVContinueFocus,home)</onunfocus>
					<content>$PARAM[content]</content>
				</control>
			</control>
		</definition>
	</include>

	<!-- ===================== BUTTONS ===================== -->

	<!-- tvOS capsule button: translucent at rest, solid white with dark text when focused -->
	<include name="ATV_CapsuleButton">
		<!-- Place inside a group that sets left/top. Actions (onclick, onup...) passed inside the
		     <include> land in the button via <nested />, which Kodi only honours on a top-level node. -->
		<param name="id" />
		<param name="width" />
		<param name="label" />
		<param name="icon">-</param>
		<param name="textoffsetx">66</param>
		<param name="align">left</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<left>0</left><top>0</top><width>$PARAM[width]</width><height>68</height>
				<label>$PARAM[label]</label>
				<font>atv_button</font>
				<textcolor>FFFFFFFF</textcolor>
				<focusedcolor>FF0B0B0D</focusedcolor>
				<align>$PARAM[align]</align><aligny>center</aligny>
				<textoffsetx>$PARAM[textoffsetx]</textoffsetx>
				<texturefocus border="34" colordiffuse="FFFFFFFF">atv/pill_68.png</texturefocus>
				<texturenofocus border="34" colordiffuse="33FFFFFF">atv/pill_68.png</texturenofocus>
				<pulseonselect>false</pulseonselect>
				<nested />
			</control>
			<!-- The same glass as the tab bar, on the buttons that are not focused -->
			<control type="image">
				<left>0</left><top>0</top><width>$PARAM[width]</width><height>68</height>
				<texture border="34" colordiffuse="17FFFFFF">atv/sheen_pill72.png</texture>
				<visible>!Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>$PARAM[width]</width><height>68</height>
				<texture border="34" colordiffuse="33FFFFFF">atv/ring_pill72.png</texture>
				<visible>!Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>28</left><top>20</top><width>28</width><height>28</height>
