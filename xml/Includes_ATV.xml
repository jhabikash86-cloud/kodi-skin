					</include>
				</control>

				<control type="label">
					<left>1480</left><top>40</top><width>350</width><height>72</height>
					<label>$INFO[System.Time]</label>
					<font>atv_clock</font>
					<textcolor>CCFFFFFF</textcolor>
					<align>right</align><aligny>center</aligny>
				</control>
			</control>
		</definition>
	</include>

