<?xml version="1.0" encoding="UTF-8"?>
<!-- Home opens at once. The rows need the Xbox's CPU in the first seconds, so no Python starts
     here unless it must: extras/dates.py only on a first start (the date windows are skin
     strings, kept between runs; extras/prefetch.py moves them on each minute), extras/setup.py
     only when the skin's version has changed since it last ran (tools/bump.py keeps the
     number below in step with addon.xml) - otherwise prefetch.py runs it a minute in, so the
     fixes to other add-ons still come back after an update. -->
<window>
	<onload condition="String.IsEmpty(Skin.String(ATVDate.today))">RunScript(special://skin/extras/dates.py,startup)</onload>
	<onload condition="!String.IsEmpty(Skin.String(ATVDate.today))">ReplaceWindow(home)</onload>
	<onload condition="!String.IsEqual(Skin.String(ATVSetupVersion),0.4.2)">RunScript(special://skin/extras/setup.py)</onload>
	<controls />
</window>
