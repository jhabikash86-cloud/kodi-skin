# Three fixes to script.module.jurialmunkey 0.2.35 (TMDb Helper's shared module). extras/setup.py
# applies them at every Kodi start wherever they are missing; this file is the record of
# what it changes (README, "Why pages went blank"). To apply by hand, from its modules folder:
#   patch -p1 < <this file>
--- a/reqapi.py
+++ b/reqapi.py
@@ -139,6 +139,15 @@
         try:
             return self._session
         except AttributeError:
+            # skin.appletv.minimal: IPv4 only. From this network TMDb's API cannot be reached
+            # over IPv6 - every attempt times out - and urllib3 tries IPv6 first, so each
+            # uncached request stalled until its timeout while holding TMDb Helper's lock on
+            # that title. Every API TMDb Helper uses answers over IPv4.
+            try:
+                import urllib3.util.connection
+                urllib3.util.connection.HAS_IPV6 = False
+            except Exception:
+                pass
             self._session = self.requests.Session()
             self._session.mount(self.req_api_url, self.requests.adapters.HTTPAdapter(pool_maxsize=100))
             return self._session
--- a/locker.py
+++ b/locker.py
@@ -8,7 +8,8 @@
         self._timeout = timeout
         self._polling = polling
         self._lockfile = lockfile
-        self._kodi_log = kodi_log
+        if kodi_log is not None:  # skin.appletv.minimal: left unset, the property below makes a logger;
+            self._kodi_log = kodi_log  # set to None it returned None, and a lock timeout crashed the caller
         self.lock_aquire()
 
     @property
--- a/bcache.py
+++ b/bcache.py
@@ -82,6 +82,11 @@
             if headers:
                 kwargs['headers'] = headers
             my_object = func(*args, **kwargs)
+            # skin.appletv.minimal: a list with no items and no pages is a request that
+            # failed (TMDb answers with at least one page); cached, it kept a row empty
+            # for six hours
+            if isinstance(my_object, dict) and 'items' in my_object and not my_object.get('items') and not my_object.get('pages'):
+                return my_object
             return self.set_cache(my_object, cache_name, cache_days, force=cache_force, fallback=cache_fallback)
 
 
