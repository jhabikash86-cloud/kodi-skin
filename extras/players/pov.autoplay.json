{
    "name": "POV (Auto Play)",
    "plugin": "plugin.video.pov",
    "priority": 90,
    "is_resolvable": "false",
    "assert": {
        "play_movie": ["tmdb"],
        "play_episode": ["tmdb", "season", "episode"]
    },
    "play_movie": "plugin://plugin.video.pov/?mode=play_media&mediatype=movie&tmdb_id={tmdb}&autoplay=true",
    "play_episode": "plugin://plugin.video.pov/?mode=play_media&mediatype=episode&tmdb_id={tmdb}&season={season}&episode={episode}&autoplay=true"
}
