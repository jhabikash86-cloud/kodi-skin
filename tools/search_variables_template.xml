	<expression name="ATV_SearchHasPerson">!String.IsEmpty(Skin.String(SearchPersonID))</expression>
	<expression name="ATV_SearchHasQuery">!String.IsEmpty(Skin.String(SearchQueryURL))</expression>
	<variable name="ATV_SearchPeoplePath">
		<value condition="$EXP[ATV_SearchHasQuery]">plugin://plugin.video.themoviedb.helper/?info=search&amp;tmdb_type=person&amp;query=$INFO[Skin.String(SearchQueryURL)]</value>
		<value>plugin://plugin.video.themoviedb.helper/?info=trending_week&amp;tmdb_type=person</value>
	</variable>
	<variable name="ATV_SearchMoviesPath">
		<value condition="$EXP[ATV_SearchHasPerson]">plugin://plugin.video.themoviedb.helper/?info=stars_in_movies&amp;tmdb_type=person&amp;tmdb_id=$INFO[Skin.String(SearchPersonID)]</value>
		<value condition="$EXP[ATV_SearchHasQuery]">plugin://plugin.video.themoviedb.helper/?info=search&amp;tmdb_type=movie&amp;query=$INFO[Skin.String(SearchQueryURL)]</value>
		<value>plugin://plugin.video.themoviedb.helper/?info=trending_week&amp;tmdb_type=movie</value>
	</variable>
	<variable name="ATV_SearchTVPath">
		<value condition="$EXP[ATV_SearchHasPerson]">plugin://plugin.video.themoviedb.helper/?info=stars_in_tvshows&amp;tmdb_type=person&amp;tmdb_id=$INFO[Skin.String(SearchPersonID)]</value>
		<value condition="$EXP[ATV_SearchHasQuery]">plugin://plugin.video.themoviedb.helper/?info=search&amp;tmdb_type=tv&amp;query=$INFO[Skin.String(SearchQueryURL)]</value>
		<value>plugin://plugin.video.themoviedb.helper/?info=trending_week&amp;tmdb_type=tv</value>
	</variable>
	<variable name="ATV_SearchPeopleHeader">
		<value condition="$EXP[ATV_SearchHasQuery]">Explore titles related to</value>
		<value>Popular People</value>
	</variable>
	<variable name="ATV_SearchMoviesHeader">
		<value condition="$EXP[ATV_SearchHasPerson]">Movies with $INFO[Skin.String(SearchPersonName)]</value>
		<value condition="$EXP[ATV_SearchHasQuery]">Movies</value>
		<value>Popular Movies</value>
	</variable>
	<variable name="ATV_SearchTVHeader">
		<value condition="$EXP[ATV_SearchHasPerson]">TV Shows with $INFO[Skin.String(SearchPersonName)]</value>
		<value condition="$EXP[ATV_SearchHasQuery]">TV Shows</value>
		<value>Popular TV Shows</value>
	</variable>
